# LatticeFlow Studio backend settings (read by backend/app/config.py from the process environment).
# Copy to .env and export, or set in your shell. All are optional. docker-compose.yml reads .env automatically.

# Torch device for MACE: auto (cuda if available, else cpu) | cuda | cuda:0 | cpu
LATTICEFLOW_DEVICE=auto

# MACE precision: float64 (default; needed for the 1e-5 eV invariance gate and 0.01 Angstrom finite-displacement phonons)
# or float32 (faster, opt-in)
LATTICEFLOW_DTYPE=float64

# Force-field backend: auto (MACE, falling back to the analytic LJ+Coulomb calculator) | mace (fail if unavailable) | fallback
LATTICEFLOW_UMLIP=auto

# MACE-MP model name passed to mace_mp (small | medium | large | ...) or a path to a local .model checkpoint
LATTICEFLOW_MACE_MODEL=small

# Total wall-clock budget (seconds) for the one-time checkpoint download; on expiry auto mode uses the fallback
LATTICEFLOW_MACE_DOWNLOAD_TIMEOUT=180

# 1 = may download the checkpoint into ~/.cache/mace (XDG_CACHE_HOME respected); 0 = local cache only, never touch the network
LATTICEFLOW_MACE_ALLOW_DOWNLOAD=1

# Materials Project API key (optional; enables POST /api/hull/evaluate)
MP_API_KEY=

# Where relaxed hull reference phases are cached (default ~/.cache/latticeflow/hull)
# LATTICEFLOW_HULL_CACHE_DIR=

# Project library + job queue database (library.db; default ~/.latticeflow)
# LATTICEFLOW_DATA_DIR=

# Size limits (atoms per structure / per phonon cell); reported by GET /api/health
# LATTICEFLOW_MAX_ATOMS=128
# LATTICEFLOW_PHONON_MAX_ATOMS=64

# Largest accepted project bundle for POST /api/projects/import, in MB (larger bodies get 413)
# LATTICEFLOW_MAX_IMPORT_MB=50

# Comma-separated CORS origins (default: the Vite dev server, http://localhost:5173 and http://127.0.0.1:5173)
# LATTICEFLOW_CORS_ORIGINS=

# Frontend (frontend/.env): talk to a backend at this URL instead of the Vite proxy
# VITE_BACKEND_URL=http://127.0.0.1:8000
