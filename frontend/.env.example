# LatticeFlow Studio frontend (Vite). Copy to .env.local to use. All optional.
#
# Backend origin. Unset (default): the browser talks to its own origin and the
# Vite dev/preview server proxies /api and /ws to http://127.0.0.1:8000.
# Set it to talk to a backend directly (it also becomes the proxy target):
# VITE_BACKEND_URL=http://127.0.0.1:8000
