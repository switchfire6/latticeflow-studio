// LatticeFlow Studio in GitHub Codespaces (or any Dev Containers host).
// Creating the codespace installs CPU torch, the backend requirements and the
// frontend, builds the frontend and caches the MACE-MP-0 small checkpoint
// (setup.sh). Every start launches the backend on :8000 and the studio on :5173
// (start.sh), and the studio opens in a browser tab when port 5173 is forwarded.
{
  "name": "LatticeFlow Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "containerEnv": {
    "LATTICEFLOW_DEVICE": "cpu"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "LatticeFlow Studio", "onAutoForward": "openBrowser" },
    "8000": { "label": "Backend API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/latticeflow/bin/python"
      },
      "extensions": ["ms-python.python"]
    }
  }
}
